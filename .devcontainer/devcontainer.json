{
	"name": "Rust",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"initializeCommand": ".devcontainer/initializeHost.sh",
	"runArgs": [
		// Host network namespace, so EtherNet/IP devices on the host's networks are directly reachable
		"--network=host",
		// GH_TOKEN for gh (and git, via the host gitconfig's gh credential helper), see the DANGER note in initializeHost.sh
		"--env-file",
		"${localWorkspaceFolder}/.devcontainer/.env"
	],
	// Shared Claude Code config and auth (see CLAUDE_CONFIG_DIR in the Dockerfile)
	"mounts": [
		"type=bind,source=${localEnv:HOME}/.claude,target=/home/vscode/.claude"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code"
			],
			"settings": {
				// With host networking, VS Code would try to auto-forward every port listening on the host (tailscaled,
				// etc.), producing a stream of permission errors
				"remote.autoForwardPorts": false
			}
		}
	}
}
